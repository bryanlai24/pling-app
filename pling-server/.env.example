# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pling

# JWT Auth
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Platform sync (optional — leave blank for manual-only use)
PSN_API_KEY=
STEAM_API_KEY=
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=